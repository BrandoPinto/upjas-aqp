rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isLoggedIn() {
      return request.auth != null;
    }

    function myRoles() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('roles', [])
        : [];
    }

    function isAdmin() {
      return isLoggedIn() && myRoles().hasAny(['admin']);
    }

    function canAwardPoints() {
      return isLoggedIn() && myRoles().hasAny(['admin', 'maestro', 'lider']);
    }

    // ── Usuarios ─────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read:   if isLoggedIn() && (request.auth.uid == uid || isAdmin() || canAwardPoints());
      allow create: if isLoggedIn() && request.auth.uid == uid;
      allow update: if isLoggedIn() && (
        request.auth.uid == uid ||
        isAdmin() ||
        (canAwardPoints() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['puntos']))
      );
      // El admin puede eliminar cualquier usuario; cada persona puede eliminar su propia cuenta (derecho de cancelación)
      allow delete: if isAdmin() || (isLoggedIn() && request.auth.uid == uid);

      match /historialPuntos/{docId} {
        allow read:   if isLoggedIn() && (request.auth.uid == uid || canAwardPoints());
        allow create: if canAwardPoints();
        allow delete: if isLoggedIn() && (request.auth.uid == uid || canAwardPoints());
      }
    }

    // ── Solicitudes de privacidad (derechos ARCO) ────────────────────────────
    // Cada persona crea las suyas y solo ve las suyas; el admin las ve y las atiende.
    match /solicitudesARCO/{docId} {
      allow create: if isLoggedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.estado == 'pendiente';
      allow read:   if isLoggedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ── Asistencias a eventos ────────────────────────────────────────────────
    match /asistencias/{docId} {
      allow read:  if isLoggedIn();
      allow write: if isLoggedIn();
    }

    // ── Usuarios bloqueados ──────────────────────────────────────────────────
    match /usuariosBloqueados/{email} {
      allow read:   if true;
      allow create: if isLoggedIn();
      allow update, delete: if isAdmin();
    }

    // ── Clases ───────────────────────────────────────────────────────────────
    match /clases/{claseId} {
      allow read:  if isLoggedIn();
      allow write: if isLoggedIn() && myRoles().hasAny(['admin', 'maestro']);
    }

    // ── Eventos ──────────────────────────────────────────────────────────────
    match /eventos/{eventoId} {
      allow read:  if isLoggedIn();
      allow write: if isAdmin();
    }

    // ── Categorías de eventos ────────────────────────────────────────────────
    match /categoriasEventos/{catId} {
      allow read:  if isLoggedIn();
      allow write: if isAdmin();
    }

    // ── Configuración global ─────────────────────────────────────────────────
    match /config/contadorJAS {
      allow read, write: if isLoggedIn();
    }
    match /config/{docId} {
      allow read:  if isLoggedIn();
      allow write: if isAdmin();
    }

    // ── Inscripciones ────────────────────────────────────────────────────────
    match /inscripciones/{docId} {
      allow read, write: if isLoggedIn() && request.auth.uid == resource.data.uid;
      allow create:      if isLoggedIn();
    }

    // ── Índice de celulares únicos ───────────────────────────────────────────
    // Solo se puede consultar un celular concreto (get); no listar la colección.
    // Guarda { uid, emailHint } para ayudar a recordar el correo sin exponerlo entero.
    match /phoneIndex/{phone} {
      allow get:   if true;
      allow list:  if false;
      allow write: if isLoggedIn();
    }

    // ── Estacas y barrios ────────────────────────────────────────────────────
    match /estacas/{estacaId} {
      allow read: if true;
      match /barrios/{barrioId} {
        allow read: if true;
      }
    }

  }
}
